# Deterministic cross-platform checkout for text files verified by SHA-256.
# Important: SKILL.md byte hashes in .ai/skills/REGISTRY.json assume LF.
* text=auto
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.txt text eol=lf
VERSION text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.rar binary
